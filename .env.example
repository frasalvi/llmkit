# Copy to .env and fill in. Values in the nearest .env win over the shell environment.
# Only the providers you call need to be set.

# Azure AI Foundry: gpt-*, claude-* (default route), and deployments such as DeepSeek/GLM/Kimi
AZURE_API_KEY=
AZURE_ENDPOINT=https://<resource>.services.ai.azure.com

# Google Vertex AI: gemini-*, and claude-* with provider="vertex"
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional: a service-account key file. Leave unset to use
# `gcloud auth application-default login` credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# OpenRouter: any other model, with provider="openrouter"
OPENROUTER_API_KEY=
